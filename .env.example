# ── IMAP (primary email access) ──────────────────────────────────────────
# If your org allows IMAP, this is the easiest method
EA_IMAP_HOST=outlook.office365.com
EA_IMAP_PORT=993
EA_IMAP_USER=your-email@company.com
EA_IMAP_PASSWORD=your-password-or-app-password
EA_IMAP_FOLDER=INBOX
EA_IMAP_POLL_INTERVAL_SECONDS=120

# ── SMTP (sending emails) ───────────────────────────────────────────────
EA_SMTP_HOST=smtp-mail.outlook.com
EA_SMTP_PORT=587
# SMTP user/password defaults to IMAP credentials if not set
# EA_SMTP_USER=
# EA_SMTP_PASSWORD=

# ── Azure AI (summarisation & drafting) ──────────────────────────────────
EA_AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
EA_AZURE_AI_KEY=your-api-key
EA_AZURE_AI_MODEL=gpt-4o
EA_AZURE_AI_API_VERSION=2024-12-01-preview

# ── Backup ───────────────────────────────────────────────────────────────
EA_BACKUP_FORMAT=both  # json, eml, or both
# EA_DATA_DIR=~/email-assistant-data

# ── Webhook (fallback when IMAP is blocked) ──────────────────────────────
# EA_WEBHOOK_SECRET=some-shared-secret

# ── WhatsApp (optional — sends summaries & alerts to WhatsApp) ────────────
# Get these from Meta Business Suite: https://business.facebook.com/
# EA_WHATSAPP_TOKEN=your-permanent-access-token
# EA_WHATSAPP_PHONE_ID=your-phone-number-id
# EA_WHATSAPP_VERIFY_TOKEN=your-chosen-verify-token
# EA_WHATSAPP_DAD_PHONE=919876543210  # with country code, no +
# EA_WHATSAPP_SECRETARY_PHONE=919876543211

# ── Sarvam AI (optional — Hindi/Marathi voice support) ────────────────────
# Get key from: https://dashboard.sarvam.ai/
# EA_SARVAM_API_KEY=your-sarvam-api-key

# ── Daily Briefing ────────────────────────────────────────────────────────
EA_BRIEFING_HOUR=8  # 8 AM — sends daily morning email & WhatsApp summary
# EA_BRIEFING_RECIPIENT=  # defaults to IMAP user email

# ── Server ───────────────────────────────────────────────────────────────
EA_HOST=0.0.0.0
EA_PORT=8000
EA_LOG_LEVEL=INFO
