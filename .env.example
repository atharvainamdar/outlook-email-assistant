# ── IMAP (primary email access) ──────────────────────────────────────────
# If your org allows IMAP, this is the easiest method
EA_IMAP_HOST=outlook.office365.com
EA_IMAP_PORT=993
EA_IMAP_USER=your-email@company.com
EA_IMAP_PASSWORD=your-password-or-app-password
EA_IMAP_FOLDER=INBOX
EA_IMAP_POLL_INTERVAL_SECONDS=120

# ── SMTP (sending emails) ───────────────────────────────────────────────
EA_SMTP_HOST=smtp-mail.outlook.com
EA_SMTP_PORT=587
# SMTP user/password defaults to IMAP credentials if not set
# EA_SMTP_USER=
# EA_SMTP_PASSWORD=

# ── Azure AI (summarisation & drafting) ──────────────────────────────────
EA_AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
EA_AZURE_AI_KEY=your-api-key
EA_AZURE_AI_MODEL=gpt-4o
EA_AZURE_AI_API_VERSION=2024-12-01-preview

# ── Backup ───────────────────────────────────────────────────────────────
EA_BACKUP_FORMAT=both  # json, eml, or both
# EA_DATA_DIR=~/email-assistant-data

# ── Webhook (fallback when IMAP is blocked) ──────────────────────────────
# EA_WEBHOOK_SECRET=some-shared-secret

# ── Server ───────────────────────────────────────────────────────────────
EA_HOST=0.0.0.0
EA_PORT=8000
EA_LOG_LEVEL=INFO
